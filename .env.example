# Environment Variables Example for Apheron Job Tracker
# Copy this file to .env and fill in your actual values
# NEVER commit the .env file to version control!

# Firebase Configuration
# Get these values from Firebase Console > Project Settings > General > Your apps
VITE_FIREBASE_API_KEY=your-firebase-api-key-here
VITE_FIREBASE_AUTH_DOMAIN=apheron-job-tracker.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=apheron-job-tracker
VITE_FIREBASE_STORAGE_BUCKET=apheron-job-tracker.firebasestorage.app
VITE_FIREBASE_MESSAGING_SENDER_ID=812993750047
VITE_FIREBASE_APP_ID=1:812993750047:web:828f3feca930a509d7612a
VITE_FIREBASE_MEASUREMENT_ID=G-Z3HM95PNET

# Google Gemini API Key (for email parsing)
# Get your API key from: https://console.cloud.google.com/apis/credentials
# IMPORTANT: Restrict this API key to your domain in Google Cloud Console
VITE_GEMINI_API_KEY=your-gemini-api-key-here

# Firebase Functions - GEMINI_API_KEY
# This must be set in Firebase Functions environment variables, not in .env
# Use: firebase functions:secrets:set GEMINI_API_KEY
# Or set in Firebase Console > Functions > Configuration > Environment variables
